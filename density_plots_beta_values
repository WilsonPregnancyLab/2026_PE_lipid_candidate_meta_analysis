#beta-value density plot

placmet_adjFunnorm_allfiltered <- readRDS("placmet_adjFunnorm_allfiltered.rds") #dim 329533 180
placmet_adjFunnorm_filtbetas_all <- getBeta(placmet_adjFunnorm_allfiltered)
lipid_gene_probes <- read.csv("lipid_gene_probes.csv")
placmet_adjFunnorm_filtbetas <- placmet_adjFunnorm_filtbetas_all[rownames(placmet_adjFunnorm_filtbetas_all) %in% lipid_gene_probes$ID,] #dim 49220 180
metadata <- read.csv("/workspace/lab/wilsonslab/eyerk/placental_methylation_data/GSE_metadata/Metadata_Sheet_lipid_preeclampsia_excluded_removed.csv")
metadata$pathology_group <- as.factor(metadata$pathology_group)
Controlmetadata_all <- subset(metadata, metadata$pathology_group == "Control") 
PEmetadata_all <- subset(metadata, metadata$pathology_group == "PE")
GSE75196 <- subset(metadata, metadata$GSE_number == "GSE75196")
GSE98224 <- subset(metadata, metadata$GSE_number == "GSE98224")
GSE100197 <- subset(metadata, metadata$GSE_number == "GSE100197")
GSE125605 <- subset(metadata, metadata$GSE_number == "GSE125605")

png(filename = "./Bval_plot_adjFunnorm.png", height = 9, width = 9, units = "in", res = 300)
plot(density(placmet_adjFunnorm_filtbetas[, 1]), col = "#F7D56E", lwd = 3,
     xlim = c(0, 1), ylim = c(0, 4), 
     xlab = "Beta-Value (N = 49220 probes)", ylab = "Density", main = " ", cex.lab = 1.2)
for (i in 2:ncol(placmet_adjFunnorm_filtbetas)) {
  lines(density(placmet_adjFunnorm_filtbetas[, i]), col = "#F7D56E", lwd = 3)
}
dev.off()

#beta-value density plot by pathology_group
png(filename = "./Bval_plot_pathology_adjFunnorm.png", height = 9, width = 9, units = "in", res = 300)
plot(density(placmet_adjFunnorm_filtbetas[, 1]), col = ifelse(metadata$pathology_group[1] == "Control", "#F7D56E", "#8EC9FF"), 
     lwd = 3, xlim = c(0, 1), ylim = c(0, 4),
     xlab = "Beta-Value (N = 44637 probes)", ylab = "Density", main = " ", cex.lab = 1.2)
control_color <- ifelse(metadata$pathology_group[i] == "Control", "#F7D56E", "#8EC9FF")
for (i in 2:ncol(placmet_adjFunnorm_filtbetas)) {
     lines(density(placmet_adjFunnorm_filtbetas[, i]), col = control_color, lwd = 3)
}
legend("topright", legend = c("Control Samples", "PE Samples"),
       col = c("#F7D56E", "#8EC9FF"),
       lwd = 3, bty = "n", cex = 1.2)
dev.off()

