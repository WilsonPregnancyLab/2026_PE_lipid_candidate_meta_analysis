#adj p-Values density plot
png(filename = "./adjPval_autosomes_adjFunnorm.png", height = 9, width = 9, units = "in", res = 300)
plot(density(placmet_wholepop_auto$adj.P.Val), col = "#F7D56E", lwd = 3,xlim = c(0,1), ylim = c(0, 5), 
     xlab = "Adjusted P-Value (N = 44637 probes)", ylab = "Density", main = " ", cex.lab = 1.2) +
  lines(density(placmet_M_fulldata_auto$adj.P.Val), col = "#8EC9FF",lwd = 3) +
  lines(density(placmet_F_fulldata_auto$adj.P.Val), col = "#E67000", lwd = 3) +
  lines(density(placmet_M_fulldata_X$adj.P.Val), col = "#0060B5", lwd = 3) +
  lines(density(placmet_F_fulldata_X$adj.P.Val), col = "#FFA6C9", lwd = 3) 
legend("topright", legend = c("All Autosomes", "Male Autosomes", "Female Autosomes", "Male X Chr", "Female X Chr"),
       col = c("#F7D56E", "#8EC9FF", "#E67000", "#0060B5", "#FFA6C9"),
       lwd = 3, bty = "n", cex = 1.2)
dev.off()

