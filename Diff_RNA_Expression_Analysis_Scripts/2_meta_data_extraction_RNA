#Merge metadata sheets to make 1 Master Metadata Sheet

metadata_list <- list (metadata114691, metadata203507, metadata148241, metadata143953, metadata204835, metadata186257, metadata218039, metadata234729, metadata255126, metadata279757)
merged_metadata <- Reduce(function(x, y) merge(x, y, all=TRUE), metadata_list)

# Download metadata sheets from SRA Run selector for each GSE. We need to match SRA IDs with GSM accessions.
SRA_GSE255126 <- read.csv("SraRunTable_GSE255126.csv")
SRA_GSE114691 <- read.csv("SraRunTable_GSE114691.csv")
SRA_GSE148241 <- read.csv("SraRunTable_GSE148241.csv")
SRA_GSE143953 <- read.csv("SraRunTable_GSE143953.csv")
SRA_GSE203507 <- read.csv("SraRunTable_GSE203507.csv")
SRA_GSE186257 <- read.csv("SraRunTable_GSE186257.csv")
SRA_GSE218039 <- read.csv("SraRunTable_GSE218039.csv")
SRA_GSE204835 <- read.csv("SraRunTable_GSE204835.csv")
SRA_GSE234729 <- read.csv("SraRunTable_GSE234729.csv")
SRA_GSE279757 <- read.csv("SraRunTable_GSE279757.csv")
SRA_list <- list (SRA_GSE255126, SRA_GSE114691, SRA_GSE148241, SRA_GSE143953, SRA_GSE203507, SRA_GSE186257, SRA_GSE218039, SRA_GSE204835, SRA_GSE234729, SRA_GSE279757)
SRA_list_merge <- Reduce(function(x, y) merge(x, y, all=TRUE), SRA_list)
metadata_list_merge <- merge(merged_metadata, SRA_list_merge[, c("Sample.Name", "Run", "BioProject", "BioSample", "SRA.Study", "LibraryLayout")], by.x = "geo_accession", by.y = "Sample.Name", all.x = TRUE)

metadata_list_merge$disease_group <- coalesce(metadata_list_merge$"disease:ch1", metadata_list_merge$"disease group:ch1", metadata_list_merge$"subject status:ch1", metadata_list_merge$"disease state:ch1", metadata_list_merge$"treatment:ch1", metadata_list_merge$"preeclampsia:ch1", metadata_list_merge$"description", metadata_list_merge$"clinical group:ch1")
metadata_list_merge$fetal_sex <- coalesce(metadata_list_merge$"assigned neonatal_sex:ch1", metadata_list_merge$"gender:ch1", metadata_list_merge$"Sex:ch1", metadata_list_merge$"fetal_sex:ch1")
metadata_list_merge$gestational_age_weeks_days <- coalesce(metadata_list_merge$"gestational age:ch1", metadata_list_merge$"gestational age_at_delivery_(weeks.days):ch1")
metadata_list_merge$maternal_ethnicity <- coalesce(metadata_list_merge$"maternal ethnicity:ch1", metadata_list_merge$"maternal_ancestry_self_report:ch1")

metadata <- metadata_list_merge[, (names(metadata_list_merge) %in% c("geo_accession", "Run", "BioProject", "BioSample", "SRA.Study", "LibraryLayout", "GSE_number", "source_name_ch1", "molecule_ch1", "platform_id", "instrument_model", "library_strategy", "title", "disease_group", "fetal_sex", "gestational_age_weeks_days", "maternal_ethnicity", "term.ch1", "sga:ch1", "cell.type:ch1", "rop:ch1", "age of_mother_(years):ch1"))]

# Review content of metadata fields to exclude samples with wrong tissue or disease, or preterm
metadata$exclude <- "keep"
metadata$exclude[metadata$term.ch1 == "Preterm"] <- "exclude"
metadata$exclude[metadata$disease_group %in% c("Chronic_hypertension", "EOPE+FGR", "FGR", "Intrauterine Growth Restriction only", "iPTB", "Preeclampsia and Intrauterine Growth Restriction", "Supermposed_preeclampsia")] <- "exclude"
metadata$exclude[metadata$source_name_ch1 %in% c("Normal_Umbilical Cord Blood", "placenta, decidua basalis")] <- "exclude"
metadata$title[is.na(metadata$disease_group)] #make sure 0

## 108 samples excluded, 334 samples kept

# Make sure all the terms for PE and Control and Fetal Sex are the same for all studies
table(metadata$disease_group) #identify which terms are PE groups and which ones are control groups
metadata$disease_group[metadata$disease_group %in% c("control", "Control", "N", "N1:fpkm", "N2:fpkm", "N3:fpkm", "N4:fpkm", "N5:fpkm", "N6:fpkm", "Non-hypertensive control", "Non-hypertensive Control", "Normal", "NP4", "NP5", "NP6", "NP7", "NP8", "NP9", "TB")] <- "Control"
metadata$disease_group[metadata$disease_group %in% c("early-onset severe preeclampsia (EOSPE)", "EOPE", "PE1:fpkm", "PE2", "PE2:fpkm", "PE3", "PE3:fpkm", "PE4", "PE4:fpkm", "PE5:fpkm", "PE6:fpkm", "PE7", "preeclampsia", "Preeclampsia", "Preeclampsia only", "Severe preeclampsia", "Severe Preeclampsia", "Y")] <- "PE"

metadata$fetal_sex[metadata$fetal_sex %in% c("F", "Female")] <- "F"
metadata$fetal_sex[metadata$fetal_sex %in% c("M", "Male")] <- "M"

write.csv(metadata, "RNA_Lipid_Candidate_Metadata.csv")


